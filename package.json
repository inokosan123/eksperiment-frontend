{
  "name": "eksperiment-frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1",
    "start:clear": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Clear",
    "start:dev-client": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Target dev-client",
    "start:dev-client:clear": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Target dev-client -Clear",
    "start:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Connection tunnel",
    "start:tunnel:clear": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Connection tunnel -Clear",
    "test:focus": "node scripts/run-focus-tests.cjs",
    "test:prayer": "node scripts/run-prayer-tests.cjs",
    "test:focus-plugin": "node scripts/test-anasta-focus-plugin.cjs",
    "test:typography": "node scripts/run-typography-tests.cjs",
    "typegen:routes": "node scripts/generate-expo-router-types.cjs",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/eb-garamond": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lottie-react-native": "~7.3.1",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-enriched-html": "1.0.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.11",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@tiptap/extension-bubble-menu": "3.20.4",
    "@tiptap/extension-floating-menu": "3.20.4"
  },
  "private": true
